{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "baymori-lead-flow-staging",
  "compatibility_date": "2026-11-13",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "baymori-leads-staging",
      "database_id": "835127cf-8468-41dd-95f9-a3bedcce13a0",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "SITE_ORIGIN": "https://baymori-lead-flow-staging.ineedthemax05.workers.dev",
    "INTAKE_ENABLED": "false"
  },
  "ratelimits": [
    {
      "name": "INQUIRY_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true
    }
  }
}
