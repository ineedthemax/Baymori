{
  "name": "baymori-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/security-headers.mjs",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "verify:static": "node scripts/verify-static.mjs",
    "test:security": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:security": "node scripts/check-security.mjs",
    "verify:staging": "wrangler deploy --dry-run --config wrangler.lead-flow.staging.jsonc",
    "types:worker": "wrangler types worker-configuration.d.ts --config wrangler.lead-flow.staging.jsonc",
    "sync:notion:staging": "node scripts/sync-notion-staging.mjs",
    "smoke:staging": "node scripts/smoke-staging.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.32"
    }
  }
}
